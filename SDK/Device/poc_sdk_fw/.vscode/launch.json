{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(Linux) Debug PoC",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/app/test_sdk",
            "args": [],
            "cwd": "${workspaceFolder}/app",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "${workspaceFolder}/setup-debug.sh",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "(Windows) Debug PoC",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/app/test_sdk.exe",
            "args": [],
            "cwd": "${workspaceFolder}/app",
            "stopAtEntry": false,
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:\\msys64\\mingw64\\bin;${workspaceFolder}\\sdk_fw\\src\\utils\\rs232;${env:PATH}"
                }
            ],
            "preLaunchTask": "make build",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
