# --- CyberRock / SandGrain ---
# CYBERROCK_BASE_URL=https://iot-api.sandbox.sandgrain.io
CYBERROCK_BASE_URL=https://device-api.sandbox.sandgrain.io

# --- MQTT / EMQX ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Device scope (topics include this)
DEVICE_ID=gw-001

# TID -> credentials mapping (JSON)
DEVICE_CREDENTIALS_JSON=./device_credentials.json

# Cloudflare Access (required for requestRW / checkRequestRWStatus)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
