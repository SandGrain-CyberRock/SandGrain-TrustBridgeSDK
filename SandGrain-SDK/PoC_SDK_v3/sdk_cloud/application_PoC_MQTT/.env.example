# --- CyberRock / SandGrain ---
# CYBERROCK_BASE_URL=https://iot-api.sandbox.sandgrain.io
CYBERROCK_BASE_URL=https://device-api-uat.sandgrain.dev

# --- MQTT broker ---
# Integrated stack (TrustBridge-BE/start-all.*): shared mosquitto on trustbridge-net.
# Standalone (docker compose --profile standalone up): set this to localhost.
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Device scope (topics include this)
DEVICE_ID=gw-001

# --- Credential source mode (two first-class modes, NOT a fallback chain) ---
#   standalone  -> creds from device_credentials.json; talk to CyberRock with no
#                  TrustBridge (this is the default for a bare sdk_cloud checkout)
#   trustbridge -> device/tenant/CF creds from the TrustBridge BE database; set
#                  BE_URL below and device_credentials.json is NOT used
CREDENTIALS_SOURCE=standalone

# Required only when CREDENTIALS_SOURCE=trustbridge (e.g. http://be:3000/api):
# BE_URL=http://be:3000/api

# TID -> credentials mapping (JSON) — used in standalone mode
DEVICE_CREDENTIALS_JSON=./device_credentials.json

# Cloudflare Access (standalone mode; required for requestRW / checkRequestRWStatus).
# In trustbridge mode these come per-tenant from the BE database instead.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
